<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btn_dialog_close"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_baseline_people_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_together"
                    android:textColor="?attr/textColor"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/watch_together_desc"
                android:textColor="?attr/grayTextColor"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_dialog_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/go_back_img_des"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="?attr/grayTextColor" />
    </RelativeLayout>

    <!-- Loading spinner -->
    <ProgressBar
        android:id="@+id/watch_together_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="16dp"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

    <!-- Error message text -->
    <TextView
        android:id="@+id/tv_watch_together_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:textColor="@color/colorAccentRed"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Room not found" />

    <!-- Section 1: When NOT currently in a room -->
    <LinearLayout
        android:id="@+id/layout_not_in_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Nickname Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/player_button_background"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_nickname"
                android:textColor="?attr/textColor"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_nickname"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/search_background"
                android:hint="@string/nickname_hint"
                android:inputType="textPersonName"
                android:maxLength="20"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/textColor"
                android:textColorHint="?attr/grayTextColor"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Host Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/player_button_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_room"
                android:textColor="?attr/textColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="Start a new Watch Party and invite friends with a code."
                android:textColor="?attr/grayTextColor"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_room"
                style="@style/WhiteButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/create_room"
                app:icon="@drawable/ic_baseline_people_24"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Divider with OR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="?attr/iconGrayBackground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="OR"
                android:textColor="?attr/grayTextColor"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="?attr/iconGrayBackground" />
        </LinearLayout>

        <!-- Join Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/player_button_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/join_room"
                android:textColor="?attr/textColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="Enter code shared by your friend to sync playback."
                android:textColor="?attr/grayTextColor"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_room_code"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/search_background"
                android:gravity="center"
                android:hint="@string/enter_room_code"
                android:inputType="textCapCharacters"
                android:maxLength="10"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/textColor"
                android:textColorHint="?attr/grayTextColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_join_room"
                style="@style/WhiteButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/join_room"
                app:icon="@drawable/ic_baseline_play_arrow_24"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>

    <!-- Section 2: When CURRENTLY in a room -->
    <LinearLayout
        android:id="@+id/layout_in_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Status & Room Code Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/player_button_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_room_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/video_button_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="● CONNECTED • HOST"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/room_code"
                android:textColor="?attr/grayTextColor"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_current_room_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:textColor="?attr/textColor"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="JOY-8924" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_room_code"
                style="@style/WhiteButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="20dp"
                android:text="@string/copy_code"
                app:icon="@drawable/copy_all_24px"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Members List Box -->
        <LinearLayout
            android:id="@+id/layout_members"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/player_button_background"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_members_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/connected_members"
                    android:textColor="?attr/textColor"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_members_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="1 online" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_members_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/grayTextColor"
                android:textSize="13sp"
                tools:text="👑 Host (Joy)" />
        </LinearLayout>

        <!-- Live Voice Call Card -->
        <LinearLayout
            android:id="@+id/layout_dialog_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/player_button_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_baseline_mic_24"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_call"
                    android:textColor="?attr/textColor"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_hold_to_talk"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_mic"
                style="@style/WhiteButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/voice_call"
                app:icon="@drawable/ic_baseline_mic_24"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Host Start Video Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_host_start_play"
            style="@style/WhiteButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:text="@string/host_start_watching"
            app:icon="@drawable/ic_baseline_play_arrow_24"
            app:iconGravity="textStart"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:gravity="center"
            android:text="@string/watch_party_info"
            android:textColor="?attr/grayTextColor"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_leave_room"
            style="@style/BlackButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/leave_room"
            android:textColor="@color/colorAccentRed"
            app:icon="@drawable/ic_baseline_close_24"
            app:iconGravity="textStart"
            app:iconTint="@color/colorAccentRed"
            app:strokeColor="@color/colorAccentRed" />
    </LinearLayout>

</LinearLayout>
